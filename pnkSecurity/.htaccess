# PNK Security — endurecimiento Apache (ASVS v5.0.0-13.4.1, 13.4.3, 13.4.7, 3.4.x)
Options -Indexes
ServerSignature Off

# Bloquear archivos ocultos, de control de versiones, respaldos y configuración
<FilesMatch "(^\.|\.(bak|old|orig|swp|sql|log|ini|env|md|map|lock|dist)$|~$)">
    Require all denied
</FilesMatch>
RedirectMatch 404 /\.git

# Forzar HTTPS en producción (descomentar cuando el sitio tenga certificado TLS)
# RewriteEngine On
# RewriteCond %{HTTPS} !=on
# RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always unset X-Powered-By
</IfModule>

# Nota: TraceEnable Off y ServerTokens Prod deben configurarse en httpd.conf (no se admiten en .htaccess).
