# =============================================================================
# Plantilla de variables para el despliegue AWS (CloudFormation).
# Copiar a  deploy/deploy.env  y completar con valores reales.
# deploy/deploy.env NO se versiona (esta en .gitignore).
#
#   cp deploy/deploy.env.example deploy/deploy.env
#   # edita los secretos
#   set -a; source deploy/deploy.env; set +a
#   ./deploy/deploy-app.sh
#
# Genera secretos fuertes con:
#   openssl rand -base64 24
# =============================================================================

# --- Stack / region ---
export STACK_NAME=pnk-eval3
export AWS_REGION=us-east-1
export ENVIRONMENT_NAME=pnk-prod

# --- Repo a clonar en las instancias (debe ser PUBLICO o accesible) ---
export APP_REPO_URL=https://github.com/Mvrt1n/PnkSecurity-Eval3.git
export APP_REPO_BRANCH=feature/tercera-evaluacion

# --- Learner Lab: perfil de instancia preexistente (no crear IAM) ---
export INSTANCE_PROFILE=LabInstanceProfile

# --- Secretos de base de datos (min 12 caracteres) ---
export DB_MASTER_PASSWORD=CAMBIA_ESTE_valor_fuerte_12+
export DB_APP_PASSWORD=CAMBIA_ESTE_otro_fuerte_12+

# --- Secretos de la aplicacion ---
export SESSION_SECRET=CAMBIA_32_bytes_aleatorios
export LOG_PEPPER=CAMBIA_aleatorio

# --- IA (opcional). Vacio = la Carta usa el fallback local deterministico ---
export IA_API_KEY=

# --- HTTPS opcional en el ALB (ARN de certificado ACM). Vacio = solo HTTP ---
export SSL_CERT_ARN=
