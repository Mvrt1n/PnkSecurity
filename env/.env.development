# ============ AMBIENTE: DESARROLLO (valores de laboratorio, NO producción) ===
# Este archivo es el único .env que se versiona, y SOLO porque contiene
# credenciales desechables de desarrollo. QA y producción usan sus propios
# archivos fuera del repositorio (ver .gitignore y los .example).

# App
PORT=3000
APP_PORT=3000
APP_DEBUG=true
APP_FORCE_HTTPS=false
TRUST_PROXY=false
APP_BASE_URL=http://localhost:3000

# PostgreSQL — rol administrador del contenedor (crea esquema + rol de app)
POSTGRES_USER=pnk_admin
POSTGRES_PASSWORD=dev_admin_pw_change_me
DB_NAME=pnk_carta

# PostgreSQL — rol de la APLICACIÓN (menor privilegio, solo DML)
DB_HOST=localhost
DB_PORT=5432
DB_USER=pnk_app
DB_PASSWORD=dev_app_pw_change_me
DB_SSL=false
DB_POOL_MAX=10

# Sesión y seguridad (en producción: secretos aleatorios de 32+ bytes)
SESSION_SECRET=dev-session-secret-change-me-0123456789abcdef
LOG_PEPPER=dev-log-pepper-0123456789
BCRYPT_ROUNDS=12

# IA (desactivada por defecto; sin API key el asistente usa el motor local)
IA_ENABLED=false
IA_PROVIDER=anthropic
IA_API_KEY=
IA_MODEL=claude-haiku-5-5
