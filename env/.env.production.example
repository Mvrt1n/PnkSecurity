# ============ AMBIENTE: PRODUCCIÓN (plantilla) ===============================
# Copiar a  env/.env.production  y completar con SECRETOS reales (idealmente
# desde un gestor de secretos / AWS SSM, no en texto plano). NO versionar.

PORT=3000
APP_PORT=3000
APP_DEBUG=false
APP_FORCE_HTTPS=true
TRUST_PROXY=true
APP_BASE_URL=https://tudominio.cl

POSTGRES_USER=pnk_admin
POSTGRES_PASSWORD=__secreto_fuerte_prod__
DB_NAME=pnk_carta_prod

DB_HOST=db
DB_PORT=5432
DB_USER=pnk_app
DB_PASSWORD=__secreto_fuerte_prod__
DB_SSL=true
DB_POOL_MAX=20

SESSION_SECRET=__aleatorio_32_bytes_prod__
LOG_PEPPER=__aleatorio_prod__
BCRYPT_ROUNDS=12

# IA en producción: la API key SOLO aquí (backend). Nunca en el frontend.
IA_ENABLED=true
IA_PROVIDER=anthropic
IA_API_KEY=__tu_api_key_prod__
IA_MODEL=claude-haiku-5-5
